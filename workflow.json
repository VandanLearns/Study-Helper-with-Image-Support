      "typeVersion": 1.3,
      "position": [784, 688],
      "webhookId": "REPLACE_WITH_YOUR_WEBHOOK_ID",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "YOUR_TELEGRAM_BOT_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.message.photo }}",
              "operator": {
                "type": "array",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "965b7e9e-a512-424b-9631-7179f34c06c0",
      "name": "Has Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1008, 688]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $(\"Extract Photo Message Content\").item.json.message.caption || \"Analyze this image and answer any questions about it\" }}",
        "options": {
          "systemMessage": "=You are a friendly, knowledgeable Telegram assistant. You remember previous messages in the conversation and provide personalized, helpful responses. The user has sent a photo. Analyze or describe it if relevant, then answer their question. If you need factual information, use the Wikipedia Search tool. Keep responses concise and suitable for Telegram. Use emojis occasionally to keep conversations engaging.",
          "maxIterations": 5,
          "passthroughBinaryImages": true
        }
      },
      "id": "544da463-aac0-446d-b9a0-0295a253ddfd",
      "name": "AI Assistant Agent (Photo)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1872, 432]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 1000,
          "temperature": 0.7
        }
      },
      "id": "dc593087-2034-4811-ab0e-89d538b6f050",
      "name": "GPT-4 Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [1808, 656],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "YOUR_OPENAI_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $(\"Extract Photo Message Content\").item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "id": "b483c506-6c05-4410-bc6e-ad0f3e713d93",
      "name": "Per-User Chat Memory (Photo)",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [1936, 656]
    },
    {
      "parameters": {},
      "id": "5dafe649-0efd-4456-a4ff-c3aaa8ece0c8",
      "name": "Wikipedia Search (Photo)",
      "type": "@n8n/n8n-nodes-langchain.toolWikipedia",
      "typeVersion": 1,
      "position": [2064, 656]
    },
    {
      "parameters": {
        "chatId": "={{ $(\"Extract Photo Message Content\").item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "id": "1a8f0482-efab-470f-8638-1b64414a8357",
      "name": "Send Photo Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2272, 544],
      "webhookId": "REPLACE_WITH_YOUR_WEBHOOK_ID",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "YOUR_TELEGRAM_BOT_CREDENTIAL_NAME"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $input.item.json.message;\nconst chatId = msg.chat.id.toString();\nconst userId = (msg.from && msg.from.id) ? msg.from.id.toString() : chatId;\nconst firstName = (msg.from && msg.from.first_name) ? msg.from.first_name : \"there\";\nconst text = msg.text || msg.caption || \"\";\n\nreturn {\n  json: {\n    chatId,\n    userId,\n    firstName,\n    userMessage: text || \"[Empty message]\",\n    sessionId: chatId\n  }\n};"
      },
      "id": "58d60544-d494-462d-a922-5a15f6a9958e",
      "name": "Extract Message Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1232, 832]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $(\"Extract Message Content\").item.json.userMessage }}",
        "options": {
          "systemMessage": "=You are a friendly, knowledgeable Telegram assistant. The user's name is {{ $(\"Extract Message Content\").item.json.firstName }}. You remember previous messages in the conversation and provide personalized, helpful responses. When explaining complex topics, use clear language. If you need factual information, use the Wikipedia Search tool. Keep responses concise and suitable for Telegram (avoid very long replies). Use emojis occasionally to keep conversations engaging.",
          "maxIterations": 5,
          "passthroughBinaryImages": true
        }
      },
      "id": "29b93f72-7718-4c04-a747-5d2a4f37a3af",
      "name": "AI Assistant Agent",
